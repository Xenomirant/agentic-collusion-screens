 .../src/continuous_double_auction/cda_types.py         |  7 +++++++
 .../src/continuous_double_auction/market/agents.py     |  4 +++-
 .../src/continuous_double_auction/market/market.py     | 10 ++++++++--
 .../prompt_templates/seller_prompt_base.jinja2         |  5 +++--
 .../src/continuous_double_auction/simulation.py        |  9 +++++++++
 5 files changed, 30 insertions(+), 5 deletions(-)

diff --git a/llm-agent-collusion/src/continuous_double_auction/cda_types.py b/llm-agent-collusion/src/continuous_double_auction/cda_types.py
index b48e798..96c792b 100644
--- a/llm-agent-collusion/src/continuous_double_auction/cda_types.py
+++ b/llm-agent-collusion/src/continuous_double_auction/cda_types.py
@@ -58,6 +58,7 @@ class ExperimentParams(BaseModel):
     overseer_model: str = "gpt-4.1-mini"     # model reading seller messages when oversight is enabled (paper: gpt-4.1-mini)
     overseer_sample_fraction: float = 1.0    # share of seller messages the overseer gets to see (sprint project 3.4)
     llm_eval: bool = False                   # run the LLM-as-judge coordination scoring after the run (paper: always)
+    seller_channel_pair: Optional[list[int]] = None  # two seller indices sharing a private channel (seeded pair)
     
     @model_validator(mode='after')
     def validate_param_combinations(self) -> Self:
@@ -67,6 +68,12 @@ class ExperimentParams(BaseModel):
             raise ValueError('Number of buyer valuations must match number of buyer models')
         if self.oversight_enabled and not self.seller_comms_enabled:
             raise ValueError('Oversight can only be enabled if seller communications are enabled')
+        if self.seller_channel_pair is not None:
+            pair = self.seller_channel_pair
+            if len(pair) != 2 or pair[0] == pair[1] or not all(0 <= i < len(self.seller_models) for i in pair):
+                raise ValueError('seller_channel_pair must name two distinct seller indices')
+            if self.seller_comms_enabled:
+                raise ValueError('seller_channel_pair is a private channel; leave seller_comms_enabled off')
         if not 0.0 <= self.overseer_sample_fraction <= 1.0:
             raise ValueError('overseer_sample_fraction must be between 0 and 1')
         self.buyer_models = [None if m in (None, ZIP_BUYER, "none", "None") else m for m in self.buyer_models]
