     scratch_pad: str = ""
+    channel_partner: Optional[str] = None  # id of the private-channel partner (seeded pair), if any
 
     class Config:
         arbitrary_types_allowed = True
@@ -266,7 +267,8 @@ class LMSeller(Agent):
             num_rounds=self.expt_params.rounds,
             hide_num_rounds=self.expt_params.hide_num_rounds,
             memory=self.memory_manager.get_formatted_memory(),
-            seller_comms_enabled=self.expt_params.seller_comms_enabled,
+            seller_comms_enabled=self.expt_params.seller_comms_enabled or self.channel_partner is not None,
+            channel_partner=self.channel_partner,
             seller_messages=kwargs.get("seller_messages", {}),
             bid_queue=kwargs.get("bid_queue", []),
             ask_queue=kwargs.get("ask_queue", []),
diff --git a/llm-agent-collusion/src/continuous_double_auction/market/market.py b/llm-agent-collusion/src/continuous_double_auction/market/market.py
index c82003b..fa1e6ed 100644
--- a/llm-agent-collusion/src/continuous_double_auction/market/market.py
+++ b/llm-agent-collusion/src/continuous_double_auction/market/market.py
@@ -120,7 +120,12 @@ class Market(BaseModel):
                 # Pass previous round's messages relevant to the agent type
                 specific_kwargs = kwargs.copy()
                 if agent in self.sellers:
-                    specific_kwargs["seller_messages"] = prev_seller_msgs
+                    partner = getattr(agent, "channel_partner", None)
+                    if partner is not None:
+                        # seeded pair: only the partner's message is delivered
+                        specific_kwargs["seller_messages"] = {k: v for k, v in prev_seller_msgs.items() if k == partner}
+                    else:
+                        specific_kwargs["seller_messages"] = prev_seller_msgs if agent.expt_params.seller_comms_enabled else {}
                     specific_kwargs["is_gag_order_active"] = self.is_gag_order_active
                 elif agent in self.buyers:
                     specific_kwargs["buyer_messages"] = prev_buyer_msgs
@@ -155,7 +160,8 @@ class Market(BaseModel):
                                 # Add ask if provided and not null
                                 self.add_seller_ask(agent, agent_bid_response["ask"])
                         # Collect message if comms enabled and message provided
-                        if agent.expt_params.seller_comms_enabled and agent_bid_response.get("message_to_sellers"):
+                        if (agent.expt_params.seller_comms_enabled or getattr(agent, "channel_partner", None)) \
+                                and agent_bid_response.get("message_to_sellers"):
                            message = agent_bid_response["message_to_sellers"]
                            # Truncate message if it exceeds max_message_length
                            if len(message) > agent.expt_params.max_message_length:
