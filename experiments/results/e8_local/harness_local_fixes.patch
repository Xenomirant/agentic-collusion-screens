+def coerce_price(value):
+    """Normalise a model-emitted price: numbers pass through, numeric strings ("79.85", "$79.85")
+    become floats, "null"/None stay the "null" sentinel, anything else is treated as no order."""
+    if value is None:
+        return None
+    if isinstance(value, bool):
+        return None
+    if isinstance(value, (int, float)):
+        return float(value)
+    if isinstance(value, str):
+        v = value.strip().strip('"').replace("$", "").replace(",", "")
+        if v.lower() in ("null", "none", ""):
+            return "null"
+        try:
+            return float(v)
+        except ValueError:
+            return None
+    return None
+
